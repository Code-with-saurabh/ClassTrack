# ClassTrack - centralized environment template
# Copy this file to `backend/.env` (server) and `frontend/.env` (client),
# then fill in the real values. All config is read through the single
# root `env.js` file.

# ---------- Backend (Node / Express) ----------
# Port the API server listens on
PORT=5000
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/classtrack
# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string
# Token expiry, e.g. 7d, 12h, 30m
JWT_EXPIRE=7d
# Allowed CORS origin (frontend URL)
CLIENT_URL=http://localhost:5173

# ---------- Frontend (Vite) ----------
# Base URL of the API (must start with VITE_ to be exposed to the client)
VITE_API_URL=http://localhost:5000/api
